# Backend configuration — copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file (it is gitignored).

# Port the Express API listens on (default: 5000)
PORT=5000

# PostgreSQL connection string.
# NOTE: the backend ALWAYS connects with SSL (src/config/db.ts), so the database
# must support SSL. This works with Neon out of the box. For a local database,
# see "Database options" in the root README.
# Option A — Neon (cloud):
# DATABASE_URL=postgresql://USER:PASSWORD@your-neon-host.aws.neon.tech/neondb?sslmode=require
# Option B — local Docker PostgreSQL with SSL enabled (see README):
DATABASE_URL=postgresql://farmdev:devpass@localhost:5433/farmfoods

# Secret used to sign JWT tokens. Use a long random string.
# If unset, the code falls back to an insecure default — always set this.
JWT_SECRET=change_me_to_a_long_random_string
